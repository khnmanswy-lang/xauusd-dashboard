# OANDA Practice API Credentials
# Get your free token and account ID from https://fxtrade.oanda.com/your_account/fxtrade/register/gate/
OANDA_API_KEY=your_oanda_v20_practice_api_token_here
OANDA_ACCOUNT_ID=101-004-xxxxxxx-001
OANDA_ENV=practice
OANDA_SYMBOL=XAU_USD

# AI Analysis Engine (Cron / Event-Driven Setup Explainer)
# Supports Gemini, OpenAI, or local Ollama
AI_PROVIDER=gemini  # Options: gemini, openai, ollama
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Risk & Scanner Settings
RISK_PER_TRADE_PERCENT=1.0
MAX_OPEN_POSITIONS=1
MAX_SPREAD_PIPS=30.0
MIN_CONFIDENCE_SCORE=0.85  # Only trigger A+ setups (>= 85% multi-TF confluence)
SCANNER_INTERVAL_SECONDS=60  # Cron frequency to evaluate market structure

